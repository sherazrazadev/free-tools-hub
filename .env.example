# Optional - leave empty for no analytics (default / privacy-safe).
# Cloudflare Pages → Settings → Environment variables → Production
PUBLIC_GA_MEASUREMENT_ID=

# Optional - Google Search Console HTML meta verification token (content= value only).
# Prefer DNS TXT verification when the domain is on Cloudflare (see docs/DEPLOY.md).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional - show empty ad layout zones (default off). Do not enable until SOP §12 eligibility.
# Still does not load AdSense JS - slots are placeholders only.
PUBLIC_ADS_ENABLED=

---
/**
 * Simple use-case icons for tool cards / mega menu.
 */
interface Props {
	slug: string;
	tint?: string;
	size?: 'sm' | 'md';
}

const { slug, tint = '#0a7a6c', size = 'md' } = Astro.props;
const dim = size === 'sm' ? 28 : 40;
---

<span class:list={['tool-icon', `tool-icon--${size}`]} style={`--icon-tint:${tint}`} aria-hidden="true">
	{
		slug === 'work-hours' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<circle cx="20" cy="20" r="12" stroke="currentColor" stroke-width="2.2" />
				<path d="M20 12v9l6 3.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
			</svg>
		) : slug === 'image-resizer' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<rect x="8" y="10" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2.2" />
				<path
					d="M18 28h12a2 2 0 0 0 2-2V14"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"
				/>
				<path d="M28 10h4v4M32 10l-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
			</svg>
		) : slug === 'image-compressor' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<path
					d="M12 14h16v12H12z"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linejoin="round"
				/>
				<path d="M16 20h8M18 16v8M22 16v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		) : slug === 'signature-formatter' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<path
					d="M8 28c4-8 6-12 10-12s4 6 8 6 4-4 6-8"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"
				/>
				<path d="M10 30h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		) : slug === 'merge-pdf' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<rect x="7" y="8" width="11" height="14" rx="1.5" stroke="currentColor" stroke-width="2" />
				<rect x="22" y="8" width="11" height="14" rx="1.5" stroke="currentColor" stroke-width="2" />
				<path d="M14 28h12M20 24v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
			</svg>
		) : slug === 'split-pdf' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<rect x="13" y="7" width="14" height="18" rx="1.5" stroke="currentColor" stroke-width="2" />
				<path d="M8 22h6M26 22h6M11 22l-3 4M29 22l3 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		) : slug === 'advertising-metrics' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<path d="M10 28V18M18 28V12M26 28V16M32 28H8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
			</svg>
		) : slug === 'freelancer-rate' ? (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<circle cx="20" cy="20" r="11" stroke="currentColor" stroke-width="2.2" />
				<path d="M20 12v16M16 16.5h5.5a2.5 2.5 0 1 1 0 5H16h6a2.5 2.5 0 1 1 0 5H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		) : (
			<svg width={dim} height={dim} viewBox="0 0 40 40" fill="none">
				<path d="M12 11h16v4H12zM12 18h16v11H12z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
				<path d="M16 22h8M16 26h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		)
	}
</span>

<style>
	.tool-icon {
		display: inline-grid;
		place-items: center;
		flex-shrink: 0;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--icon-tint) 16%, var(--color-surface));
		color: var(--icon-tint);
	}

	.tool-icon--sm {
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
	}

	.tool-icon--md {
		width: 2.75rem;
		height: 2.75rem;
	}

	.tool-icon svg {
		display: block;
	}
</style>

---
import AdSlot from '../components/ads/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ui/ToolIcon.astro';
import { liveCategories, liveTools } from '../lib/routes';

const featured = liveTools()[0];
const cats = liveCategories();
const tools = liveTools();
---

<BaseLayout
	title="TommyTools - Free browser calculators and file utilities"
	description="Free online calculators and file utilities that run in your browser. No accounts, no paid AI APIs for core features, and local processing when a tool says so."
>
	<section class="home-hero" aria-label="Introduction">
		<div class="home-hero__glow" aria-hidden="true"></div>
		<div class="home-hero__inner">
			<p class="home-hero__brand">TommyTools</p>
			<h1 class="home-headline">
				Every practical utility you need.
				<span class="home-headline__accent">For free.</span>
			</h1>
			<p class="home-lede">
				Work hours, photos, PDFs, and business math - in your browser. No accounts. Local
				processing when a tool says so.
			</p>
			<div class="home-cta">
				<a class="btn btn--hero-primary" href="#tools">Explore all tools</a>
				{
					featured ? (
						<a class="btn btn--hero-ghost" href={featured.path}>
							Try {featured.name}
						</a>
					) : null
				}
			</div>
		</div>
	</section>

	<section class="home-tools" aria-labelledby="home-tools-heading" id="tools">
		<div class="home-tools__inner">
			<header class="home-section-head">
				<p class="home-section-head__eyebrow">Catalog</p>
				<h2 id="home-tools-heading">Tools</h2>
				<p class="home-section-head__lede">Open any utility - no signup, no install.</p>
			</header>

			<ul class="home-grid">
				{
					tools.map((tool) => (
						<li>
							<a class="tool-card" href={tool.path} style={`--card-tint:${tool.tint}`}>
								<ToolIcon slug={tool.slug} tint={tool.tint} size="md" />
								<span class="tool-card__body">
									<span class="tool-card__title">{tool.name}</span>
									<span class="tool-card__blurb">{tool.blurb}</span>
									<span class="tool-card__open">Open tool →</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<div class="home-ad">
				<AdSlot zone="home-below-tools" size="banner" />
			</div>
		</div>
	</section>

	<section class="home-cats" aria-labelledby="home-cats-heading">
		<div class="home-cats__inner">
			<header class="home-section-head">
				<p class="home-section-head__eyebrow">Browse</p>
				<h2 id="home-cats-heading">By category</h2>
				<p class="home-section-head__lede">Pick a family, then open the tool you need.</p>
			</header>
			<div class="home-cat-grid">
				{
					cats.map((category) => (
						<article class="home-cat" style={`--cat-tint:${category.tint}`}>
							<div class="home-cat__top">
								<span class="home-cat__dot" aria-hidden="true" />
								<h3>{category.name}</h3>
							</div>
							<p>{category.blurb}</p>
							<ul>
								{category.tools.map((tool) => (
									<li>
										<a href={tool.path}>
											<ToolIcon slug={tool.slug} tint={category.tint} size="sm" />
											<span>{tool.name}</span>
											<span class="home-cat__arrow" aria-hidden="true">
												→
											</span>
										</a>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="home-band" aria-label="Next steps">
		<div class="home-band__inner">
			<p class="home-band__eyebrow">TommyTools</p>
			<h2 class="home-band__title">
				Built for real tasks.
				<span class="home-band__accent">No accounts.</span>
			</h2>
			<p class="home-band__lede">
				Questions about privacy or how a tool works? Start with FAQ or About.
			</p>
			<div class="home-cta">
				<a class="btn btn--hero-primary" href="/faq">FAQ</a>
				<a class="btn btn--hero-ghost" href="/about">About</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.home-hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid color-mix(in srgb, #fff 18%, transparent);
		background: linear-gradient(165deg, #065f55 0%, #0a7a6c 42%, #0b4f6c 100%);
		color: #fff;
	}

	.home-hero__glow {
		position: absolute;
		inset: -20% 10% auto;
		height: 70%;
		background: radial-gradient(closest-side, #1a9d8c 0%, transparent 72%);
		opacity: 0.85;
		pointer-events: none;
	}

	.home-hero__inner {
		position: relative;
		width: min(100% - 2.5rem, 48rem);
		margin: 0 auto;
		padding: clamp(3.25rem, 9vw, 5.5rem) 0 clamp(3rem, 7vw, 4.5rem);
		text-align: center;
		animation: home-rise 0.55s var(--ease-out) both;
	}

	.home-hero__brand {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 78%, transparent);
	}

	.home-headline {
		margin: 0 auto 1rem;
		max-width: 16ch;
		font-size: clamp(2.1rem, 5.8vw, 3.15rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 1.08;
		color: #fff;
	}

	.home-headline__accent {
		display: block;
		color: var(--color-hero-gold);
	}

	.home-lede {
		margin: 0 auto 1.6rem;
		max-width: 36rem;
		color: color-mix(in srgb, #fff 84%, transparent);
		font-size: 1.1rem;
		line-height: 1.55;
	}

	.home-cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.home-hero :global(.btn--hero-primary),
	.home-band :global(.btn--hero-primary) {
		background: #fff;
		color: var(--color-accent-deep);
		border-color: #fff;
	}

	.home-hero :global(.btn--hero-primary:hover),
	.home-band :global(.btn--hero-primary:hover) {
		background: color-mix(in srgb, #fff 90%, var(--color-accent));
	}

	.home-hero :global(.btn--hero-ghost),
	.home-band :global(.btn--hero-ghost) {
		background: transparent;
		color: #fff;
		border-color: color-mix(in srgb, #fff 55%, transparent);
	}

	.home-hero :global(.btn--hero-ghost:hover),
	.home-band :global(.btn--hero-ghost:hover) {
		border-color: #fff;
		background: color-mix(in srgb, #fff 12%, transparent);
	}

	.home-tools {
		scroll-margin-top: 5.5rem;
		padding: clamp(3rem, 6vw, 4.5rem) 0;
		background:
			radial-gradient(70% 50% at 0% 0%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 55%),
			var(--color-bg-elevated);
	}

	.home-ad:not(:has(.ad-slot)) {
		display: none;
	}

	.home-ad:has(.ad-slot) {
		margin-top: var(--space-6);
	}

	.home-tools__inner,
	.home-cats__inner {
		width: min(100% - 2.5rem, var(--shell-width));
		margin: 0 auto;
	}

	.home-section-head {
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
		max-width: 36rem;
		animation: home-rise 0.5s var(--ease-out) both;
		animation-delay: 0.05s;
	}

	.home-section-head__eyebrow {
		margin: 0 0 0.45rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent-deep);
	}

	.home-section-head h2 {
		margin: 0;
		font-size: clamp(1.65rem, 3.2vw, 2.1rem);
		letter-spacing: -0.035em;
		line-height: 1.15;
	}

	.home-section-head__lede {
		margin: 0.45rem 0 0;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.home-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16.75rem, 1fr));
		gap: 1.15rem;
	}

	.tool-card {
		display: flex;
		align-items: flex-start;
		gap: 0.95rem;
		min-height: 9rem;
		padding: 1.3rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--card-tint, var(--color-accent)) 7%, var(--color-surface)) 0%,
				var(--color-surface) 48%
			);
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-soft);
		transition:
			transform var(--duration-med) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-med) var(--ease-out);
	}

	.tool-card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--card-tint, var(--color-accent)) 40%, var(--color-border));
		box-shadow: var(--shadow-menu);
	}

	.tool-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}

	.tool-card__title {
		font-family: var(--font-display);
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--color-fg);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.tool-card:hover .tool-card__title {
		color: var(--color-accent-deep);
	}

	.tool-card__blurb {
		color: var(--color-muted);
		font-size: 0.94rem;
		line-height: 1.5;
	}

	.tool-card__open {
		margin-top: 0.45rem;
		color: var(--color-accent-deep);
		font-size: 0.9rem;
		font-weight: 700;
		opacity: 0;
		transform: translateY(0.15rem);
		transition:
			opacity var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.tool-card:hover .tool-card__open {
		opacity: 1;
		transform: translateY(0);
	}

	.home-cats {
		padding: clamp(3rem, 6vw, 4.5rem) 0;
		border-top: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 70%, var(--color-bg));
	}

	.home-cat-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.15rem;
		content-visibility: auto;
		contain-intrinsic-size: auto 24rem;
	}

	.home-cat {
		padding: 1.35rem 1.3rem 1.2rem;
		border: 1px solid color-mix(in srgb, var(--cat-tint) 22%, var(--color-border));
		border-radius: var(--radius-lg);
		background:
			linear-gradient(
				165deg,
				color-mix(in srgb, var(--cat-tint) 12%, var(--color-surface)) 0%,
				var(--color-surface) 55%
			);
		box-shadow: var(--shadow-soft);
	}

	.home-cat__top {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.4rem;
	}

	.home-cat__dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 999px;
		background: var(--cat-tint);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--cat-tint) 18%, transparent);
	}

	.home-cat h3 {
		margin: 0;
		font-size: 1.12rem;
		font-weight: 700;
		letter-spacing: -0.025em;
	}

	.home-cat > p {
		margin: 0 0 1rem;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.home-cat ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.3rem;
	}

	.home-cat a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.45rem 0.35rem;
		border-radius: var(--radius-sm);
		color: var(--color-fg);
		font-size: 0.96rem;
		font-weight: 600;
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.home-cat a span:nth-child(2) {
		flex: 1;
		min-width: 0;
	}

	.home-cat__arrow {
		color: var(--color-muted);
		font-weight: 700;
		opacity: 0;
		transition:
			opacity var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	.home-cat a:hover {
		color: var(--color-accent-deep);
	}

	.home-cat a:hover .home-cat__arrow {
		opacity: 1;
		color: var(--color-accent-deep);
	}

	.home-band {
		position: relative;
		overflow: hidden;
		padding: clamp(3rem, 7vw, 4.5rem) 0;
		background: linear-gradient(165deg, #065f55 0%, #0a7a6c 45%, #0b4f6c 100%);
		color: #fff;
	}

	.home-band::before {
		content: '';
		position: absolute;
		inset: -30% 20% auto;
		height: 80%;
		background: radial-gradient(closest-side, #1a9d8c 0%, transparent 70%);
		opacity: 0.75;
		pointer-events: none;
	}

	.home-band__inner {
		position: relative;
		width: min(100% - 2.5rem, 40rem);
		margin: 0 auto;
		text-align: center;
	}

	.home-band__eyebrow {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 76%, transparent);
	}

	.home-band__title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.7rem, 4vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.15;
		color: #fff;
	}

	.home-band__accent {
		display: block;
		color: var(--color-hero-gold);
	}

	.home-band__lede {
		margin: 0 auto 1.4rem;
		max-width: 32rem;
		color: color-mix(in srgb, #fff 84%, transparent);
		font-size: 1.05rem;
		line-height: 1.55;
	}

	@keyframes home-rise {
		from {
			opacity: 0;
			transform: translateY(0.6rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__inner,
		.home-section-head {
			animation: none;
		}

		.tool-card {
			transition: none;
		}

		.tool-card:hover {
			transform: none;
		}

		.tool-card__open,
		.home-cat__arrow {
			opacity: 1;
			transform: none;
		}
	}
</style>

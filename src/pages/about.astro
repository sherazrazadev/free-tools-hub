---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProsePage from '../components/ui/ProsePage.astro';
---

<BaseLayout
	title="About TommyTools | Free browser utilities"
	description="About TommyTools (tools.tommyfx.pk): free browser calculators and file utilities with no accounts and no paid AI APIs for core features."
>
	<ProsePage title="About TommyTools">
		<p>
			<strong>TommyTools</strong> at <a href="https://tools.tommyfx.pk">tools.tommyfx.pk</a> is a free
			utility site for practical calculators and file helpers that run in your browser - built for
			clear tasks, not account walls.
		</p>

		<h2>Categories we build</h2>
		<ul>
			<li>Work hours and shift calculators</li>
			<li>Application photo and signature helpers</li>
			<li>File and media utilities</li>
			<li>Business and finance calculators</li>
			<li>AI governance and security self-check utilities</li>
		</ul>

		<h2>How it works</h2>
		<p>
			Core tools are meant to run in your browser with JavaScript, Canvas, and open-source client
			libraries. There are no user accounts, no product database, and no paid AI APIs for core
			features in v1.
		</p>
		<p>
			Individual tools ship when they are correct and usable. This site prefers fewer accurate
			tools over a long list of unfinished pages.
		</p>

		<p class="note">
			Calculators and checklists are estimates or informal self-assessments - not legal, payroll,
			tax, or certification advice. See <a href="/terms">Terms</a> and
			<a href="/privacy">Privacy</a>.
		</p>
	</ProsePage>
</BaseLayout>

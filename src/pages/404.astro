---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProsePage from '../components/ui/ProsePage.astro';
import ToolIcon from '../components/ui/ToolIcon.astro';
import { liveTools } from '../lib/routes';

const popularSlugs = ['work-hours', 'merge-pdf', 'image-compressor', 'freelancer-rate'];
const tools = liveTools().filter((tool) => popularSlugs.includes(tool.slug));
---

<BaseLayout
	title="Page not found | TommyTools"
	description="That page does not exist. Go back to the TommyTools home page or open a popular tool."
	noindex
>
	<ProsePage
		title="Page not found"
		lede="The link may be old or mistyped. Pick up where you left off below."
	>
		<div class="nf-actions">
			<a class="btn btn--primary" href="/">Back to home</a>
			<a class="btn btn--ghost" href="/#tools">Browse all tools</a>
		</div>

		{
			tools.length > 0 && (
				<>
					<h2>Popular tools</h2>
					<ul class="nf-tools">
						{tools.map((tool) => (
							<li>
								<a href={tool.path}>
									<ToolIcon slug={tool.slug} tint={tool.tint} size="sm" />
									<span>{tool.name}</span>
								</a>
							</li>
						))}
					</ul>
				</>
			)
		}

		<p>
			Still stuck? Check the <a href="/faq">FAQ</a> or <a href="/contact">send feedback</a>.
		</p>
	</ProsePage>
</BaseLayout>

<style>
	.nf-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-bottom: var(--space-5);
	}

	.nf-actions :global(a.btn) {
		text-decoration: none;
	}

	/* ProsePage body styles links teal; keep button text readable. */
	.nf-actions :global(a.btn--primary),
	.nf-actions :global(a.btn--primary:hover) {
		color: #fff;
	}

	.nf-actions :global(a.btn--ghost) {
		color: var(--color-fg);
	}

	.nf-actions :global(a.btn--ghost:hover) {
		color: var(--color-accent-deep);
	}

	.nf-tools {
		list-style: none;
		margin: 0 0 var(--space-5);
		padding: 0;
		display: grid;
		gap: var(--space-2);
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
	}

	.nf-tools li {
		margin: 0;
		padding: 0;
	}

	.nf-tools a {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 2.75rem;
		padding: 0.45rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-fg);
		text-decoration: none;
		transition:
			border-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	.nf-tools a:hover {
		border-color: var(--color-accent);
		color: var(--color-accent-deep);
	}
</style>

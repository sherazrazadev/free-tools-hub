---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProsePage from '../../components/ui/ProsePage.astro';
import ToolIcon from '../../components/ui/ToolIcon.astro';
import { getPublishedGuides, toolBySlug } from '../../lib/guides';
import { formatGuideDate } from '../../lib/guides/guides';

const guides = getPublishedGuides().map((guide) => ({ guide, tool: toolBySlug(guide.tool)! }));
---

<BaseLayout
	title="Guides - Step-by-step how-tos | TommyTools"
	description="Short, practical guides for common tasks: work hours with breaks, resizing photos for forms, merging PDFs. Each one ends in a free browser tool."
	noindex={guides.length === 0}
>
	<ProsePage
		title="Guides"
		wide
		lede="Short how-tos for everyday tasks. Each one ends in a tool you can use right away."
	>
		{
			guides.length > 0 ? (
				<ul class="guide-list">
					{guides.map(({ guide, tool }) => (
						<li>
							<a class="guide-card" href={`/guides/${guide.slug}`}>
								<ToolIcon slug={tool.slug} tint={tool.tint} size="md" />
								<span class="guide-card__body">
									<span class="guide-card__title">{guide.title}</span>
									<span class="guide-card__desc">{guide.description}</span>
									<span class="guide-card__meta">
										<time datetime={guide.publishDate}>{formatGuideDate(guide.publishDate)}</time>
										<span aria-hidden="true">·</span>
										<span>Uses: {tool.name}</span>
									</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p>No guides yet. New ones appear here as they are published.</p>
			)
		}
	</ProsePage>
</BaseLayout>

<style>
	/* Doubled class beats ProsePage's body ul/li rules (padding, margin). */
	.guide-list.guide-list {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 700px) {
		.guide-list.guide-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.guide-list.guide-list > li {
		margin: 0;
		padding: 0;
		display: flex;
	}

	.guide-card {
		display: flex;
		flex: 1;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 1.1rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-soft);
		text-decoration: none;
		transition:
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-med) var(--ease-out);
	}

	.guide-card:hover,
	.guide-card:focus-visible {
		border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
		box-shadow: var(--shadow-menu);
	}

	.guide-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.guide-card__title {
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--color-fg);
	}

	.guide-card__desc {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.guide-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.5rem;
		color: var(--color-muted);
		font-size: 0.85rem;
	}
</style>
